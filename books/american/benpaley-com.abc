[ce]2 [ee]2 [ee]3 [ef] | [ee]2 [ce]2 [Be]2 [Ae]2 | [Be][ce]-[ce][Be] [Ae][ce][Be][Ae] | [FA]2 [FA]2 [EA]3 [FA] ||
