%%sep 1 1 400
%%center Le Passe-tems.
%%begintext align
%%   Le Grand Rond - - - 2/1
%%endtext
%%begintext align
%%   The first and third Ladies Chass\'e and change
%% places with the Ladies on their Right, then
%% half La Chaine to their own places - 1/2
