%%begintext align
%% First Man take Hands with his Partner, and lead her down the Middle,
%% the Man go on the Wo. Side, and the Wo. on the Man's, then 1st Man
%% side with Foot and Elbow, the 2d Wo. and the 1st Wo. side with Foot and
%% Elbow the 2d Man, and turn Sides to their own Places.
%%endtext
%%sep 1 1 300
%%begintext align
%% Cross over with their Partners, and go round about the 1st Cu. 'till the
%% 1st Man comes into the 2d Man's Place, and the 1st Wo. into the 2d Wo.
%% Place, then 1st Man cross over with the 2d Wo. and 1st Wo. with the 2d
%% Man, then all four clap Hands, and Hands half round and turn single.
%% [CCDM1]
%%endtext
%%sep 1 8 500
% Source: sources/jc/JohnWalsh/Bellamira.abc

