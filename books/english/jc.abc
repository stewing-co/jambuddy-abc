%% by the right Hand, then the 1st Wo. being in the 2d Wo. Place, the
%% 2d Wo. turns the 1st Man, and the 1st Man the 3d Wo. with their
%% right Hands, so meet in the middle and turn to your own Sides :|
%% [CCDM1]
%%endtext
