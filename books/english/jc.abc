%%begintext align
%% Lead up a D. forward and back, sett
%% and turn S .| That again :|
%%		First Cu. change Places, sett and turn S .| First
%%		Man lead your own and the 2d Wo. forward and
%%		back, bring the 2d Wo. under your Arms, leave her
%%		and turn your own :| do thus to the last, the rest
%%		following and doing the like.
%%endtext
%%sep 1 1 300
%%begintext align
%% Sides all, sett and turn S .| That again :|
%%		First Cu. change Places, sett and turn S .| First
%%		Cu. meet the 2d Cu. lead each other's Wo. to
%%		each Wall, meet your own and turn them. Do
%%		thus to the last, the rest following.
%%endtext
%%sep 1 1 300
%%begintext align
%% Arms all, sett and turn S .| That again :|
%%		First Cu. take both Hands, slip down between
%%		the 2d Cu. cross and turn each one of them
%%		with your right Hands, fall to your own Side
%%		in the 2d Cu. Place .| Do thus to the last, the rest
%%		following.
%% [CCDM1]
%%endtext
%%sep 1 8 500
% Source: sources/jc/JohnWalsh/Chearily_and_merrily_6.abc

