%% Back to Back with the 2d Man, the 1st Man leading the 2d Wo. to the Presence,
%% and the 1st Wo. with the 2d Man lead down at the same Time; then all four
%% face together, and Hands right and left to the End.
%% [CCDM1]
%%endtext
