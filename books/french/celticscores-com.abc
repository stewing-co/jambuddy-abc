%%rm
%%rm  1. Me m'eus bet plijadur, e Lambaol a wechou
%%rm     O ober tro an iliz, gand an all bannielou
%%rm
%%rm  2. Hag o stoui ganto dirag an aoter vraz
%%rm     Hag ouz o sevel kerkent, er vann,
%%rm                             ken dres all hoaz
%%rm
%%rm  3. Plijadur am beze pa veze ar pardon
%%rm     O ober tro ar vered gand an dud a galon
%%rm
%%rm  4. Eno'veze gwelet, pa groge an avel,
%%rm     Piou oa baotred wella da zougen ar banniel
%%rm
%%rm  5. Ha dre ma tremened, a bep tu d'ar vali
%%rm     Gant o zeod flour ar merhed a roe o ali
%%rm
%%rm  6. Hag a rae o dibad etouez ar baotred vrao
%%rm     A welent, en o haera, o tremen dirazo.

