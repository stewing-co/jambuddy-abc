%%rm C'est un joyeux blondin     ] bis
%%rm
%%bf Refrain :
%%it Revenez-y donc ma jolie demoiselle,
%%it Car il est, car il est en train mon moulin,
%%it Revenez-y donc ma jolie demoiselle,
