%%newpage
%%textrmfont     Courier 16.0
%%textitfont     Courier-Oblique 16.0
%%textbffont     Courier-Bold 16.0
%%rm
%%rm
%%rm À la noce d'Étienne, j'ai dansé comme une mitaine
%%rm Et j'ai promis, à André, qui était mon cavalier,
%%rm Une scottish une gigouillette, une danse aux quatre coins
%%rm Un avant-deux, un pas d'été poitevin.
%%rm
%%it 1,2,3 les femmes étaient en place aux cuisines
%%it 1,2,3 les hommes avaient un bouquet à la main
%%it 1,2,3 les enfants taquinaient les cousines
%%it 1,2,3 elles étaient belles depuis le matin.
%%rm  
%%rm Tante Louisette, tante Jeanne, tante Paulette
%%rm                                          et tante Monette
%%rm Étaient postées, aux entrées de la maison,
%%rm Pour acceuillir, les Gazeau les Moreau les Bobin
%%rm Et toutes les familles, qui n'étaient pas du canton.
%%rm
%%rm Élise s'est, trompée dans, la couleur des robes à fleurs
%%rm Elle a crié, crié "Vive la mariée",
%%rm En voyant entre deux paires de jambes à sa hauteur
%%rm Apparaitre, la soutane, de monsieur, le curé.
%%rm
%%rm Dans le poirier, sur la haie du pré brûlé du pré à blé
%%rm Chapeau gants blancs, et voile de la mariée,
%%rm Dansent au vent, Étienne essaye de les attraper
%%rm Sous l'oeil des invités, beaux comme un dessin de Bugeant.
%%rm
%%rm René à l'accordéon Jean-Baptiste au violon et au piston,
%%rm Le vieux Paul, le père d'Mathilde et Léon,
%%rm Ouvrent le bal, et font danser les jeunesses
%%rm Et les anciens font des prouesses, pour épater les garçons.
%%rm
%%rm À la noce d'Étienne, j'ai dansé comme une mitaine
%%rm Et j'ai promis, à André, qui était mon cavalier,
%%rm Une scottish une gigouillette, une danse aux quatre coins
%%rm Un avant-deux, un pas d'été poitevin.
% Source: sources/termen-free-fr/danses/termen/ScottishLanocedEtienne.abc

X:62
T:Tour : Riche marchand
Z:Roger Négaret (Février 2000)
C:Trad.
S:
A:Bretagne
M:2/4
L:1/8
K:C
cB/2c/2 A>e | de cA | cB/2c/2 A>e | de c2 :|
Gc/2d/2 e>d | fe c2 | dd/2e/2 dc/2d/2 | ec A2 |
Gc/2d/2 e>g | fe c2 | dd/2e/2 dc/2d/2 | ec A2 |]
%%rm
%%rm Salut à vous gens de la danse             ]
%%rm Mettez-vous donc tous en liance           ] bis
%%rm
%%rm Entrez, venez vous amuser                 ]
%%rm D'la belle histoire que j'ai ouïe contë   ] bis
%%rm
%%rm C'est à vous toutes les jeunes filles
%%rm C'est à vous toutes les jeunes filles
%%rm Qui faisiez le tour de vos champs
%%rm Et n'avez point trouvé d'galant.  
%%rm
%%rm C'est pas comme moi quand j'étais jeune
%%rm C'est pas comme moi quand j'étais jeune
%%rm Les galants couraient après moi
%%rm Pour les baisers que je leur donnais.  
%%rm
%%rm Y'avait Joseph, Jean-Pierre et Jacques
%%rm Y'avait Joseph, Jean-Pierre et Jacques
%%rm Y'avait aussi le grand Charlot
%%rm C'est c'ty là qui venait à vélo.      
%%rm
%%rm C't'y là était propriétaire           
%%rm D'une grande maison construite en pierre
%%rm D'une armoire et d'un grand buffet 
%%rm Qui lui servait de cabinet.             
%%rm
%%rm Ça të par un dimëne au saï              
%%rm Ça të par un dimëne au saï              
%%rm Qu'il est venu me demander
%%rm Si je voulais bien m'y marier. 
%%rm
%%rm La réponse fût bentôt faite
%%rm La réponse fût bentôt faite
%%rm Oh oui, oh oui mon Jean-François
%%rm Ca fait-y longtemps que je t'attendais.
%%rm
%%rm Nous ne ferons pas grande noce
%%rm Car j'avons point d'sous dedans ma poche
%%rm Si seulement tu n'avais autant. 
%%rm J'inviterions tous nos parents.
%%rm
%%rm J'inviterions tonton tontine
%%rm J'inviterions cousin cousine
%%rm J'inviterions l'père Mathurin
%%rm J'crois ben qu'c't'y là était mon parrain.
% Source: sources/termen-free-fr/danses/termen/TourRichemarchand.abc

