X:26
%%indent         1.5cm
%%wordsfont      Times-Italic 10
T:Ma bergere, non l\'egere
C:Gabriel Bataille
L:1/4
M:none
% %leftmargin 1cm
% %rightmargin 1cm
%%staves [F | L]
K:Dm
%%scale 0.6
%
