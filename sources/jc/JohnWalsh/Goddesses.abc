%%begintext align
%% Lead up a D. forward and back .| That again :|
%% Cast off meet below .| Cast off below meed above :|
%%endtext
%%sep 1 8 500
%%begintext align
%% Men go down on the outside of the We .| Back again :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% We. as much :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% Men go quite round about the We :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% We. as much :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% Men take Hands and go round .| Back again :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% We. as much :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% Then all Hands and go half round .| Back again :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% Men the S. Hey :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
%% We. as much :| This as before :|
%%endtext
%%sep 1 8 500
%%begintext align
