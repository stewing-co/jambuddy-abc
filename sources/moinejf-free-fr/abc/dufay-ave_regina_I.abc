X: 1
T: Ave Regina Coelorum I
C: Guillaume Dufay (1400 ca. - 1474)
M: 3/4
L: 1/4
Q: 1/4 = 110
%%MIDI program 73 % flute
%%staves [1 2 3]
V: 1 clef=treble name="Soprano" sname="S"
V: 2 clef=treble name="Tenor" sname="T"
V: 3 clef=bass   name="Bass"  sname="B" octave=-2
