%%rm
%%rm
%%rm
%%rm  1. Dans le port il est arrivé (bis)
%%rm     Un navire en cuivre doublé (bis)
%%rm     Que personne n'a visité
%%rm     Que la fille d'un conseiller.
%%rm
%%it     Par ma foi, j'donn'rai bien cinq sous
%%it     Pour passer la barque avec elle,
%%it     Par ma foi, j'donn'rai bien cinq sous
%%it     Pour passer la barque avec vous.
%%rm
%%rm  2. Le capitaine a deviné (bis)
%%rm     Quel profit il pourrait tirer (bis)
%%rm     S'il était assez fortuné
%%rm     Pour qu'elle voulut bien l'épouser.
%%rm
%%rm  3. Aussi d'un air intéressé (bis)
%%rm     Au devant d'elle s'est empressé (bis)
%%rm     Mais tout bas il a ordonné
%%rm     De lever l'ancre et s'éloigner.
%%rm
%%rm  4. Un mois après, s'étant aimés (bis)
%%rm     Ils étaient tous deux mariés (bis)
%%rm     Pendant ce temps le conseiller
%%rm     En tous lieux sa fille cherchait.
%%rm
%%rm  5. À Nantes un jour est arrivé (bis)
%%rm     Des Indes un vaisseau chargé (bis)
%%rm     De cachemires, de café,
%%rm     D'épices et de brocarts dorés.
%%rm
%%rm  6. Étant allés les marchander (bis)
%%rm     On vit la fille du conseiller (bis)
%%rm     Ayant assis à ses côtés
%%rm     Six enfants aux cheveux bouclés.
%%rm
%%rm  7. Le grand-père étant arrivé (bis)
%%rm     Les a tous les six embrassés (bis)
%%rm     En disant : j'avais bien pleuré
%%rm     Maintenant je vais m'égayer !
 
