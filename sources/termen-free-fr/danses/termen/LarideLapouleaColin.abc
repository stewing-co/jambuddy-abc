%%rm  1. Colin a une poule                    ]
%%rm     Qui pond tous les matins             ] bis
%%rm     A été faire sa ponte 
%%rm     Dans la cour à Martin
%%rm
%%bf Refrain :
%%it Sur l'eau, sur la rivière, sur le bord de la mer
%%it Sur l'eau, sur la rivière, sur le bord du vaisseau.   
%%rm
%%rm  2. Martin a pris sa fourche             ]
%%rm     Lui a cassé les reins                ] bis
%%rm     En fit une fricassée 
%%rm     Pour le dimanche matin.
%%rm
%%rm  3. Tout l'monde de la paroisse          ]
%%rm     Est v'nu saucer son pain             ] bis
%%rm     Ainsi qu'monsieur le curé
%%rm     Qu'est venu saucer le sien.
%%rm
%%rm  4. Trouva la sauce si bonne             ]
%%rm     Qu'il y trempa les mains             ] bis
%%rm     Les mains bien jusqu'aux coudes
%%rm     Des coudes jusqu'aux reins.
%%rm
%%rm  5. Il fit manquer la messe              ]
%%rm     À tous ses paroissiens               ] bis
%%rm     À toutes ces bonnes vieilles
%%rm     Qui en ont tant besoin.
%%rm
%%rm  6. À toutes ces bonnes p'tites vieilles ]
%%rm     Qui en ont tant besoin               ] bis
%%rm     Ainsi finit l'histoire
%%rm     De la poule à Colin.

