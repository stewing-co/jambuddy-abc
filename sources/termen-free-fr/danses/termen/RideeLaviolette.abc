%%it     La violette gai, gai, gaiement
%%bf     ... répétition instruments ...
%%rm
%%rm  2. La pâture ou je les mène 
%%rm     Le grand chemin passe dedans
%%rm
%%rm  3. Par le grand chemin y passe
%%rm     Trois jeunes cavaliers galants
%%rm
%%rm  4. Là ils m'ont demandé
%%rm     Belle combien gagnez-vous par an
%%rm
%%rm  5. J'y gagne bien cinq cents mille francs
%%rm     Et un beau cotillon blanc
%%rm
%%rm  6. Venez avec moi la belle
%%rm     Je vous en donnerais autant.

