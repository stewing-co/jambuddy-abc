 %%begintext
Visite théâtralisée d'Issy-les -Moulineaux au Chemin des Vignes
%%endtext
%%space 5 cm

%%titleleft
%%textfont Helvetica 16
%%infoline 1

 
%%footer $D   Galouvielle-MBe 2007 \nmarch (--)
